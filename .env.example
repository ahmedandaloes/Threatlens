# ThreatLens LLM configuration (optional — without any key ThreatLens runs fully offline).
# Copy to .env and fill ONE of the options below. .env is git-ignored.

# --- Option A: Ollama Cloud (recommended, OpenAI-compatible endpoint) -------------------
# Create a key at https://ollama.com/settings/keys
OPENAI_BASE_URL=https://ollama.com/v1
OPENAI_API_KEY=your-ollama-api-key
MODEL=gpt-oss:120b
# Alias: instead of OPENAI_API_KEY you may set OLLAMA_API_KEY=your-ollama-api-key
# (base URL then defaults to https://ollama.com/v1 and MODEL to gpt-oss:120b).
# List the cloud models your key can use:  curl https://ollama.com/api/tags

# --- Option B: OpenAI ---------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini

# --- Option C: OpenRouter -----------------------------------------------------------------
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL=openai/gpt-4o-mini

# --- Option D: Groq -----------------------------------------------------------------------
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile

# --- Option E: local Ollama (no key needed by the server, any value works) ------------------
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL=gpt-oss:20b
